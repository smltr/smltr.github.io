---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => {
    return {
      params: { slug: post.data.slug },
      props: { post },
    };
  });
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const words = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
const readingTime = Math.max(1, Math.ceil(words / 225));
const formattedDate = new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(post.data.date);
---

<BaseLayout title={`${post.data.title} — Sam Trouy`} description={post.data.description} type="article">
  <article class="article-shell">
    <header class="article-header">
      <a class="back-link" href="/blog/"><span aria-hidden="true">←</span> All writing</a>
      <p class="article-kicker">Field note / {post.data.date.getFullYear()}</p>
      <h1>{post.data.title}</h1>
      <div class="article-meta">
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        <span>{readingTime} min read</span>
      </div>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
